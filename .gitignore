# LaTeX build artifacts (transient — re-creatable by latexmk)
# Final PDFs in build/ are tracked (see explicit !**/build/*.pdf below).
**/build/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.bcf
*.run.xml
*-blx.bib
*.brf
*.idx
*.ind
*.ilg
*.glg
*.glo
*.gls
*.glsdefs
*.ist
*.nav
*.snm

# Editor temp
.DS_Store
*.swp
*.swo
~$*
*.tmp

# Pandoc temp
*.pandoc-aux

# Generated PDFs next to .tex are transient (use build/ for tracked)
conference/tex/main.pdf
journal/tex/main.pdf
supplementary/conference/*.pdf
supplementary/journal/*.pdf

# Track the final PDFs and DOCX so a reader does not have to run
# the build to inspect them
!conference/build/
!conference/build/main.pdf
!journal/build/
!journal/build/main.pdf
!supplementary/build/
!supplementary/build/*.pdf
!conference/word/
!conference/word/main.docx
!journal/word/
!journal/word/main.docx
!supplementary/word/
!supplementary/word/**/*.docx

# Reference templates downloaded archives
templates/*.zip
templates/*.tar.gz
